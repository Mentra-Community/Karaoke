<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Karaoke</title>
    <link rel="stylesheet" href="/css/karaoke.css">
</head>
<body>
    <div class="app">
        <header class="hero">
            <div class="hero-row">
                <div class="badge" id="state-badge">
                    <span class="dot" id="state-dot"></span>
                    <span id="state-label">Connecting…</span>
                </div>
            </div>
            <h1>Karaoke</h1>
            <p class="tagline">Sing along on your glasses.</p>
        </header>

        <section class="now-playing" id="now-playing">
            <div class="np-empty" id="np-empty">
                <div class="ear">👂</div>
                <p class="np-title">Listening for a song…</p>
                <p class="np-sub">Play any track nearby and we'll catch the lyrics.</p>
            </div>

            <div class="np-active" id="np-active" hidden>
                <p class="np-eyebrow">Now Playing</p>
                <h2 class="np-title" id="song-title">—</h2>
                <p class="np-artist" id="song-artist">—</p>
                <div class="np-meta">
                    <span id="song-position">0:00</span>
                    <span class="dot-sep">•</span>
                    <span id="song-duration">0:00</span>
                    <span class="dot-sep">•</span>
                    <span id="song-lyrics-flag">No lyrics</span>
                </div>
            </div>
        </section>

        <section class="lyrics" id="lyrics-section" hidden>
            <p class="np-eyebrow">Lyrics</p>
            <div class="lyrics-card">
                <div class="lyrics-current" id="lyrics-current"></div>
                <div class="lyrics-progress">
                    <div class="lyrics-progress-bar" id="lyrics-progress-bar"></div>
                </div>
                <div class="lyrics-next" id="lyrics-next"></div>
            </div>
        </section>

        <section class="display-log">
            <details>
                <summary>
                    <span class="display-log-title">Display log</span>
                    <span class="display-log-sub" id="display-log-count">0 frames</span>
                </summary>
                <ol class="display-log-list" id="display-log-list">
                    <li class="display-log-empty">Nothing on screen yet.</li>
                </ol>
            </details>
        </section>

        <section class="history">
            <h3>Recently identified</h3>
            <ol class="history-list" id="history-list">
                <li class="history-empty">Nothing yet.</li>
            </ol>
        </section>

        <footer class="footer">
            <% if (userId) { %>
                <span class="user-id"><%= userId %></span>
            <% } else { %>
                <span class="user-id muted">Not signed in</span>
            <% } %>
        </footer>
    </div>

    <script>
    (function () {
        const $ = (id) => document.getElementById(id);
        const stateLabel = $("state-label");
        const stateDot = $("state-dot");
        const npEmpty = $("np-empty");
        const npActive = $("np-active");
        const songTitle = $("song-title");
        const songArtist = $("song-artist");
        const songPosition = $("song-position");
        const songDuration = $("song-duration");
        const songLyricsFlag = $("song-lyrics-flag");
        const lyricsSection = $("lyrics-section");
        const lyricsCurrent = $("lyrics-current");
        const lyricsNext = $("lyrics-next");
        const lyricsProgressBar = $("lyrics-progress-bar");
        const displayLogList = $("display-log-list");
        const displayLogCount = $("display-log-count");
        const historyList = $("history-list");

        const STATE_LABELS = {
            LISTENING: "Listening",
            PROCESSING: "Processing",
            SONG_DETECTED_WITH_LYRICS: "Singing along",
            SONG_DETECTED_NO_LYRICS: "Song detected",
            DISCONNECTED: "Not connected",
        };

        function fmtTime(seconds) {
            if (typeof seconds !== "number" || !isFinite(seconds) || seconds < 0) return "0:00";
            const m = Math.floor(seconds / 60);
            const s = Math.floor(seconds % 60).toString().padStart(2, "0");
            return m + ":" + s;
        }

        function fmtRelative(ts) {
            const diff = Math.max(0, Date.now() - ts);
            const s = Math.floor(diff / 1000);
            if (s < 60) return s + "s ago";
            const m = Math.floor(s / 60);
            if (m < 60) return m + "m ago";
            const h = Math.floor(m / 60);
            return h + "h ago";
        }

        function applyState(state) {
            stateLabel.textContent = STATE_LABELS[state] ?? state;
            stateDot.dataset.state = state;
        }

        function applySong(song) {
            if (!song) {
                npEmpty.hidden = false;
                npActive.hidden = true;
                return;
            }
            npEmpty.hidden = true;
            npActive.hidden = false;
            songTitle.textContent = song.title || "Unknown";
            songArtist.textContent = song.artist || "Unknown artist";
            songPosition.textContent = fmtTime(song.position);
            songDuration.textContent = fmtTime(song.duration);
            songLyricsFlag.textContent = song.hasLyrics ? "Synced lyrics" : "No lyrics";
            songLyricsFlag.dataset.lyrics = song.hasLyrics ? "yes" : "no";
        }

        function applyLyrics(lyrics) {
            // lyrics: { position, current: {lines, startTime, endTime} | null, next: {...} | null } | null
            if (!lyrics || !lyrics.current) {
                lyricsSection.hidden = true;
                return;
            }
            lyricsSection.hidden = false;

            const cur = lyrics.current;
            lyricsCurrent.innerHTML = cur.lines
                .map((line) => `<p class="lyrics-line">${escapeHtml(line) || "&nbsp;"}</p>`)
                .join("");

            if (lyrics.next && lyrics.next.lines.length > 0) {
                lyricsNext.innerHTML = lyrics.next.lines
                    .slice(0, 2)
                    .map((line) => `<p class="lyrics-line-next">${escapeHtml(line) || "&nbsp;"}</p>`)
                    .join("");
            } else {
                lyricsNext.innerHTML = "";
            }

            // Progress through the current chunk
            const span = Math.max(0.01, cur.endTime - cur.startTime);
            const through = Math.max(0, Math.min(1, (lyrics.position - cur.startTime) / span));
            lyricsProgressBar.style.transform = `scaleX(${through})`;
        }

        function fmtClock(ts) {
            const d = new Date(ts);
            const hh = d.getHours().toString().padStart(2, "0");
            const mm = d.getMinutes().toString().padStart(2, "0");
            const ss = d.getSeconds().toString().padStart(2, "0");
            const ms = d.getMilliseconds().toString().padStart(3, "0");
            return `${hh}:${mm}:${ss}.${ms}`;
        }

        function fmtDuration(ms) {
            if (typeof ms !== "number" || ms < 0) return "";
            if (ms < 1000) return ms + "ms";
            const s = ms / 1000;
            return s.toFixed(s >= 10 ? 1 : 2) + "s";
        }

        function applyDisplayLog(frames) {
            if (!frames || frames.length === 0) {
                displayLogList.innerHTML = '<li class="display-log-empty">Nothing on screen yet.</li>';
                displayLogCount.textContent = "0 frames";
                return;
            }
            displayLogCount.textContent = frames.length + " frame" + (frames.length === 1 ? "" : "s");
            // Newest first
            const rows = frames.slice().reverse().map((f) => {
                const meta = [
                    `<span class="dl-time">${fmtClock(f.at)}</span>`,
                    `<span class="dl-dur">${fmtDuration(f.durationMs)}</span>`,
                    `<span class="dl-state" data-state="${f.appState}">${f.appState}</span>`,
                    f.song ? `<span class="dl-position">${fmtTime(f.position)}/${fmtTime(f.song.duration)}</span>` : "",
                ].filter(Boolean).join("");

                const body = (f.lines && f.lines.length > 0 ? f.lines : [f.text || ""])
                    .map((line) => `<span class="dl-line">${escapeHtml(line) || "&nbsp;"}</span>`)
                    .join("");

                return `
                    <li class="display-log-row" data-state="${f.appState}">
                        <div class="dl-meta">${meta}</div>
                        <pre class="dl-body">${body}</pre>
                    </li>
                `;
            }).join("");
            displayLogList.innerHTML = rows;
        }

        function applyHistory(items) {
            if (!items || items.length === 0) {
                historyList.innerHTML = '<li class="history-empty">Nothing yet.</li>';
                return;
            }
            historyList.innerHTML = items
                .map((h) => `
                    <li class="history-item">
                        <div class="history-text">
                            <span class="history-title">${escapeHtml(h.title)}</span>
                            <span class="history-artist">${escapeHtml(h.artist)}</span>
                        </div>
                        <span class="history-time">${fmtRelative(h.identifiedAt)}</span>
                    </li>
                `)
                .join("");
        }

        function escapeHtml(s) {
            return String(s ?? "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
        }

        async function tick() {
            try {
                const r = await fetch("/api/stats", {credentials: "include"});
                if (!r.ok) {
                    applyState("DISCONNECTED");
                    return;
                }
                const data = await r.json();
                applyState(data.connected ? data.state : "DISCONNECTED");
                applySong(data.currentSong);
                applyLyrics(data.lyrics);
                applyDisplayLog(data.displayHistory);
                applyHistory(data.history);
            } catch (_err) {
                applyState("DISCONNECTED");
            }
        }

        tick();
        setInterval(tick, 1000);
    })();
    </script>
</body>
</html>
