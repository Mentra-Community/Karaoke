# Karaoke miniapp env template. Copy to .env for local dev.
# Each deploy target uses its own package name + API key:
#   prod   com.mentra.karaoke        (deployed manually from main)
#   dev    com.mentra.karaoke.dev    (auto-deployed from dev branch)
#   local  com.mentra.karaoke.<you>  (your machine, via ngrok)

# Use `mentra app api-key <package-name>` to mint/rotate this.
MENTRAOS_API_KEY=your_mentra_api_key_here

# Package name registered in console.mentra.glass.
PACKAGE_NAME=com.mentra.karaoke.isaiah

# Server port (Porter injects its own in deploy).
PORT=3000

# Signs the session cookie used by the SDK auth middleware.
# Must be >=8 chars; generate with: openssl rand -hex 32
COOKIE_SECRET=replace_me_with_openssl_rand_hex_32

# ACRCloud configuration. Get from https://console.acrcloud.com/
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
ACRCLOUD_HOST=
ACRCLOUD_PROJECT_ID=
ACRCLOUD_PROJECT_NAME=
